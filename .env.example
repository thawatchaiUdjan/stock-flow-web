# Copy to .env and fill in. Never commit .env.
# The stack ticket's scaffold owns these names: keep this file in step with what the code reads.
# Only variables prefixed VITE_ reach the browser bundle; nothing here is prefixed, so nothing here is public.

# Where the Vite dev server proxies /api/* during local development (the local stock-flow-api).
# In production, vercel.json rewrites /api/* to the api's Vercel deployment instead.
API_PROXY_TARGET=http://localhost:8080
