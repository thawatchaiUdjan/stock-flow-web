      "Bash(bunx shadcn add *)",
      "Bash(bunx shadcn docs *)",
      "Bash(bunx shadcn info *)",
      "Bash(bunx shadcn search *)",
      "Bash(bunx shadcn view *)",
      "PowerShell(git *)",
      "PowerShell(gh issue view *)",
      "PowerShell(gh issue comment *)",
      "PowerShell(gh pr create *)",
      "PowerShell(gh pr view *)",
      "PowerShell(glab issue view *)",
      "PowerShell(glab issue note *)",
      "PowerShell(glab mr create *)",
      "PowerShell(glab mr view *)",
      "PowerShell(bun install)",
      "PowerShell(bun install --frozen-lockfile)",
      "PowerShell(bun run typecheck)",
      "PowerShell(bun run build)",
      "PowerShell(bun run test *)",
      "PowerShell(bun run e2e *)",
      "PowerShell(bun run ci)",
      "PowerShell(bun run lint)",
      "PowerShell(bun run format)",
      "PowerShell(bun run format:check)",
      "PowerShell(bun run api:sync)",
      "PowerShell(bun run api:generate)",
      "PowerShell(bun run api:check)",
      "PowerShell(bunx playwright install chromium)",
      "PowerShell(bunx --no-install --package @tanstack/intent intent *)",
      "PowerShell(bunx shadcn add *)",
      "PowerShell(bunx shadcn docs *)",
      "PowerShell(bunx shadcn info *)",
